# ──────────────────────────────────────────────────────────────────────────────
# DermAI — Environment Variables Template
# Copy this file to .env and fill in values. NEVER commit .env to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=DermAI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dermai
POSTGRES_USER=dermai_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://dermai_user:change_me_in_production@db:5432/dermai

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Storage ───────────────────────────────────────────────────────────────────
# Use 'local' for development (files saved in backend/storage/)
# Use 'minio' for production-like setup
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# MinIO settings (only needed if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=dermai-images
MINIO_SECURE=false

# ── Demo Seed Users (passwords for scripts/seed.py) ──────────────────────────
SEED_ADMIN_EMAIL=admin@dermai.local
SEED_ADMIN_PASSWORD=Admin@DermAI2024
SEED_CLINICIAN_EMAIL=clinician@dermai.local
SEED_CLINICIAN_PASSWORD=Clinician@DermAI2024
SEED_PATIENT_EMAIL=patient@dermai.local
SEED_PATIENT_PASSWORD=Patient@DermAI2024
SEED_RESEARCHER_EMAIL=researcher@dermai.local
SEED_RESEARCHER_PASSWORD=Researcher@DermAI2024
SEED_ML_EMAIL=mlengineer@dermai.local
SEED_ML_PASSWORD=MLEngineer@DermAI2024

# ── ML / Preprocessing ────────────────────────────────────────────────────────
MODEL_INPUT_SIZE=224
HAIR_REMOVAL_ENABLED=true
CLAHE_ENABLED=true
