# ==============================================================================
# DermAI: Environment Configuration Template (.env.example)
# Note: Copy this file to .env and customize for local development or production.
# Never commit real credentials or .env to version control!
# ==============================================================================

# --- Application Core ---
APP_NAME="DermAI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# --- Mandatory Regulatory & Clinical Notice ---
MEDICAL_DISCLAIMER="AI-assisted analysis, not a standalone medical diagnosis."

# --- Security & Authentication (Argon2 + JWT) ---
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dermai-insecure-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database Configuration ---
# Local Rapid Development (SQLite):
DATABASE_URL="sqlite:///./dermai.db"
# Docker / Production (PostgreSQL 16):
# DATABASE_URL="postgresql://dermai_user:dermai_password@localhost:5432/dermai_db"

# --- Storage Backend ---
# Supported: local, minio, s3
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/storage"

# MinIO / AWS S3 Settings (optional when STORAGE_BACKEND=minio or s3):
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="dermai-images"
S3_REGION="us-east-1"

# --- Redis (Optional Caching & Rate Limiting) ---
REDIS_URL="redis://localhost:6379/0"

# --- Machine Learning Service & Weights ---
ML_SERVICE_URL="http://localhost:8001"
DERMAI_WEIGHTS_DIR="./models"
DERMAI_CONFIDENCE_THRESHOLD=0.50
ML_DEVICE="cpu"

# --- MLflow Experiment Tracking ---
MLFLOW_TRACKING_URI="file:./mlruns"
# MLFLOW_TRACKING_URI="http://localhost:5000"

# --- Role-Based Demo Seed Passwords (for scripts/seed.py) ---
DEMO_PATIENT_PASSWORD="PatientSecure123!"
DEMO_CLINICIAN_PASSWORD="ClinicianDoctor123!"
DEMO_RESEARCHER_PASSWORD="ResearchScience123!"
DEMO_ML_ENGINEER_PASSWORD="MLEngineerModel123!"
DEMO_ADMIN_PASSWORD="AdminSuperUser123!"
