rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cases/{caseCode}/{filename} {
      // Authenticated users can read case images
      allow read: if request.auth != null;
      // Image upload size limited to 10 MB and valid image content types
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
